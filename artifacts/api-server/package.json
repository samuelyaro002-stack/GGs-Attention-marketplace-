{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:celo-price": "node --test src/celo-price.test.mjs",
    "test:rewards": "pnpm --filter @workspace/ggs-marketplace exec tsx --test ../api-server/src/reward-security.test.mjs ../api-server/src/reward-verification.local.test.mjs ../api-server/src/celo-reward-verification.test.mjs ../api-server/src/celo-payout.test.mjs",
    "test:auth": "pnpm --filter @workspace/ggs-marketplace exec tsx --test ../api-server/src/privy-auth.test.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/celo-contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.18.1",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
