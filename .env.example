# Copy to .env for local work. Never commit .env. On a host, set these as secrets/variables.

# ---- Required ----
DATABASE_URL=postgresql://user:password@host:5432/gg
PORT=8080
# Long random string (for example: openssl rand -hex 32). Signs CELO price quotes.
SESSION_SECRET=
# Privy app ID (public). The browser copy is read at BUILD time.
PRIVY_APP_ID=cmuy2gr1500570dl5gzd38b44
VITE_PRIVY_APP_ID=cmuy2gr1500570dl5gzd38b44
# Comma-separated Privy user IDs allowed to use the admin pages.
PRIVY_ADMIN_USER_IDS=did:privy:cmuy3rkr102130cl6zr8nvo6x

# ---- Web origin (production) ----
# Your public site, so the API accepts requests from it.
FRONTEND_ORIGINS=https://ggattention.app
# Number of reverse proxies in front of the API (0 to 5). Most hosts: 1.
TRUST_PROXY_HOPS=1

# ---- CELO reward pool (Celo Sepolia test network today) ----
CELO_REWARD_POOL_NETWORK=sepolia
CELO_REWARD_POOL_APPROVED=true
CELO_REWARD_POOL_CONTRACT_ADDRESS=0xCC38DF5ce9D64E18e37d790368FcC9a63459f4Bc
CELO_REWARD_POOL_OWNER_WALLET=0x91b2D43890e6Ace6b1D104c51212965E8925a015
CELO_REWARD_POOL_PROTOCOL_WALLET=0x0d8C36615D9026d8658da26C9A1E1C44B469865D
CELO_REWARD_POOL_RUNTIME_CODE_HASH=0x7b2322fbd2e22d0dfffbe03e18926cfa4f3d4ad48bd235e69cde660dcbc27fb9
# Optional RPC override (use a private RPC URL as a secret if it carries a key).
# CELO_REWARD_POOL_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# CELO_REWARD_POOL_MAINNET_RPC_URL=

# ---- Optional ----
LOG_LEVEL=info
# Folder that holds artifacts/*/dist (defaults to the working directory).
# WEB_ROOT=/app
